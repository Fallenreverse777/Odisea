# Copy this file to .env and fill it in.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a code your phone must enter before chatting with Shadow.
# Strongly recommended, otherwise anyone on your Wi-Fi can talk to Shadow on your bill.
SHADOW_ACCESS_CODE=

# Optional tuning
# SHADOW_MODEL=claude-opus-5-5
# SHADOW_EFFORT=low
# SHADOW_USER_NAME=
