# Copy this file to .env and adjust.

# Optional: a code your phone must enter before chatting with Shadow.
SHADOW_ACCESS_CODE=

# Optional: your name (Shadow can also learn it: "my name is ...")
# SHADOW_USER_NAME=

# Shadow's brain:
#   rules  = its own if/else logic. Free, offline, no key needed. (default)
#   claude = use the Claude API (needs the key below and `pip install anthropic`)
# SHADOW_BRAIN=rules
# ANTHROPIC_API_KEY=sk-ant-...
